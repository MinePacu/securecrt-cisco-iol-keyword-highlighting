<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Install-KeywordHighlight-Setup</AssemblyName>
    <RootNamespace>InstallKeywordHighlightSetup</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Keep in sync with Install-KeywordHighlight.ps1's $script:UpdateFileNames and launcher/Program.cs (ScriptLogicalName/IniLogicalName/ChangelogLogicalName). -->
  <ItemGroup>
    <EmbeddedResource Include="../Install-KeywordHighlight.ps1">
      <LogicalName>Install-KeywordHighlight.ps1</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../PNET-Cisco-Dark.ini">
      <LogicalName>PNET-Cisco-Dark.ini</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../PNET-Cisco-Dark-V3.ini">
      <LogicalName>PNET-Cisco-Dark-V3.ini</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../CHANGELOG.md">
      <LogicalName>CHANGELOG.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
